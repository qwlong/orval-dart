import 'package:json_annotation/json_annotation.dart';

{{#if description}}
{{dartDoc description indent=0}}
{{/if}}
enum {{enumName}} {
{{#each values}}
{{#if description}}
  /// {{description}}
{{/if}}
{{#if ../isNumeric}}
  @JsonValue({{value}})
{{else}}
  @JsonValue('{{value}}')
{{/if}}
  {{name}}{{#unless @last}},{{/unless}}
{{#unless @last}}

{{/unless}}
{{/each}}
}

/// Extension methods for {{enumName}}
extension {{enumName}}Extension on {{enumName}} {
{{#if isNumeric}}
  num get value {
    switch (this) {
{{#each values}}
      case {{../enumName}}.{{name}}:
        return {{value}};
{{/each}}
    }
  }

  static {{enumName}}? fromValue(num? value) {
    if (value == null) return null;
    switch (value) {
{{#each values}}
      case {{value}}:
        return {{../enumName}}.{{name}};
{{/each}}
      default:
        return null;
    }
  }
{{else}}
  String get value {
    switch (this) {
{{#each values}}
      case {{../enumName}}.{{name}}:
        return '{{value}}';
{{/each}}
    }
  }

  static {{enumName}} fromValue(String? value) {
    if (value == null) return {{enumName}}.{{unknownName}};
    switch (value) {
{{#each values}}
{{#unless (eq name ../unknownName)}}
      case '{{value}}':
        return {{../enumName}}.{{name}};
{{/unless}}
{{/each}}
      default:
        return {{enumName}}.{{unknownName}};
    }
  }
{{/if}}
}
