/// Serializes `format: date` values as calendar dates. They map to DateTime
/// like `date-time` does, but the wire format is YYYY-MM-DD, and the default
/// DateTime encoding would send a full timestamp.
///
/// The time of day is dropped and the calendar date is read in whatever zone
/// the DateTime carries, so convert to the zone the date is meant to be in
/// before sending. Beware that `DateTime(2026, 5, 13).toUtc()` carries UTC and
/// therefore sends the 12th from UTC+8.
class _DateOnlyConverter implements JsonConverter<DateTime, String> {
  const _DateOnlyConverter();

  @override
  DateTime fromJson(String json) => DateTime.parse(json);

  @override
  String toJson(DateTime date) =>
      '${date.year.toString().padLeft(4, '0')}-'
      '${date.month.toString().padLeft(2, '0')}-'
      '${date.day.toString().padLeft(2, '0')}';
}
